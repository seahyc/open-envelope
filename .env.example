PORT=3100
DATABASE_PATH=./data/openenvelope.db
LOG_LEVEL=info

OBJECT_STORAGE_TYPE=local
OBJECT_STORAGE_LOCAL_PATH=./data/documents

APP_MODE=selfhost
AUTH_MODE=none
AUTH_HEADER_NAME=X-Auth-User
ALLOWED_EMAILS=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ACCESS_GATE=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_MAGIC_CAPTURE=0
# Google + magic-link sign-up stay off unless AUTH_MODE=session AND AUTH_SIGNUP=1
AUTH_SIGNUP=0
LLM_HOUSEHOLD_DAILY_CAP=50

INGEST_API_KEY=

# Mailbox poller (off unless MAIL_POLL_IMAP_USER is set). See README "Email Alert Ingestion".
# MAIL_POLL_IMAP_USER=you@gmail.com
# MAIL_POLL_IMAP_PASSWORD=
# MAIL_POLL_RECIPIENT=
# MAIL_POLL_QUERY=
# MAIL_POLL_INTERVAL_SECONDS=300
# MAIL_POLL_LOOKBACK_DAYS=3

# Context signals (all default off). Webhook ingest: CONTEXT_WEBHOOK=1
# CONTEXT_LOCATION=0
# CONTEXT_CALENDAR=0
# CONTEXT_ORDERS=0
# CONTEXT_TRIANGULATE=0
# CONTEXT_WEBHOOK=0

DEMO_MODE=false

# LLM Provider (none|codex|openai)
LLM_PROVIDER=none
CODEX_BIN=/usr/local/bin/codex
CODEX_HOME=/tmp/codex-home
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low
# Optional comma-separated -c overrides, e.g. mcp_servers={}
CODEX_EXTRA_CONFIG=
LLM_CACHE_ENABLED=true
LLM_TIMEOUT=30000
LLM_RATE_LIMIT=10

# Merchant lookup for opaque PayNow/FAST/GIRO lines (acra, web, or acra,web)
MERCHANT_ENRICHMENT=acra
# Optional single-dataset override; default uses ACRA letter files on data.gov.sg
# ACRA_RESOURCE_ID=

# Categoriser (none|memory-only|codex|jev)
CATEGORISER_PROVIDER=none
CATEGORISER_AUTO_THRESHOLD=0.9
# Optional comma/newline regexes; empty means none
CATEGORISER_ALWAYS_REVIEW=

BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_AGE_PUBLIC_KEY=
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_BYTES=536870912

OE_BIND=127.0.0.1
OE_PORT=3100
